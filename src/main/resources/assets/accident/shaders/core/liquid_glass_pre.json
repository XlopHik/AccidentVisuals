  },
  "passes": [
    {
      "vertex_shader": "rich:core/blit_fullscreen",
      "fragment_shader": "rich:core/blur1",
      "inputs": [
        { "sampler_name": "Diffuse", "target": "minecraft:main", "bilinear": true }
      ],
      "output": "rich:blur_x",
      "uniforms": { "Config": [ { "type": "vec2", "value": [1.0, 0.0] } ] }
    },
    {
      "vertex_shader": "rich:core/blit_fullscreen",
      "fragment_shader": "rich:core/blur1",
