        { "sampler_name": "Diffuse", "target": "rich:blur_x", "bilinear": true }
      ],
      "output": "rich:blurred",
      "uniforms": { "Config": [ { "type": "vec2", "value": [0.0, 1.0] } ] }
    },
    {
      "vertex_shader": "rich:core/blit_fullscreen",
      "fragment_shader": "rich:core/bloom",
      "inputs": [
        {
          "sampler_name": "iChannel0",
          "target": "minecraft:main",
          "bilinear": true
        },
        {
          "sampler_name": "iChannel1",
          "target": "rich:blurred",
          "bilinear": true
        }
